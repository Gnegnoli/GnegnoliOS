pkgname=gnegnolios-release
pkgver=0.1
pkgrel=1
pkgdesc="Release files for GnegnoliOS"
arch=('any')
license=('custom')
install=gnegnolios-release.install

source=(
    "os-release"
)

sha256sums=(
    'SKIP'
)

package() {

    install -Dm644 "$srcdir/os-release" \
        "$pkgdir/usr/share/gnegnolios/os-release"

    install -Dm755 "$startdir/files/usr/share/libalpm/scripts/gnegnolios-os-release" \
        "$pkgdir/usr/share/libalpm/scripts/gnegnolios-os-release"

    install -Dm644 "$startdir/files/usr/share/libalpm/hooks/90-gnegnolios-os-release.hook" \
        "$pkgdir/usr/share/libalpm/hooks/90-gnegnolios-os-release.hook"

}
