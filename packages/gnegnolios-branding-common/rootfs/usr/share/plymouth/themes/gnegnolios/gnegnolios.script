Window.SetBackgroundTopColor(0.05, 0.05, 0.05);
Window.SetBackgroundBottomColor(0.05, 0.05, 0.05);

num_frames = 100;

for (i = 0; i < num_frames; i++)
  frame_image[i] = Image("frame_" + i + ".png");

frame_sprite = Sprite();
frame_sprite.SetX(Window.GetWidth() / 2 - frame_image[0].GetWidth() / 2);
frame_sprite.SetY(Window.GetHeight() / 2 - frame_image[0].GetHeight() / 2);

progress = 0;

fun refresh_callback()
{
  frame_sprite.SetImage(frame_image[Math.Int(progress / 5) % num_frames]);
  progress++;
}

Plymouth.SetRefreshFunction(refresh_callback);
