pkgname=gnegnolios-installer-config
pkgver=0.1
pkgrel=1
pkgdesc="Smart installer catalog for GnegnoliOS"
arch=('any')
license=('custom')
depends=('python' 'python-yaml')

source=()

sha256sums=()

package() {

    install -Dm644 "$startdir/README.md" \
        "$pkgdir/usr/share/doc/gnegnolios-installer-config/README.md"

    install -Dm644 "$startdir/../../config/installer.yaml" \
        "$pkgdir/usr/share/gnegnolios/installer/catalog.yaml"

    install -Dm755 "$startdir/files/usr/bin/gnegnolios-installer-resolve" \
        "$pkgdir/usr/bin/gnegnolios-installer-resolve"

}
